///|
/// `config` prints `yaml.safe_dump`, so `y_dump` has to match PyYAML byte for
/// byte: key order, quoting, indentation and line wrapping all show up in the
/// output. The fixtures under `testdata/` are generated by
/// `scripts/check-yaml-dump.py`; rerun it after changing the emitter.
test "yaml dump matches pyyaml" {
  let corpus = @fs.read_file_to_string("testdata/yaml_dump_corpus.yaml") catch {
    _ => ""
  }
  let expected = @fs.read_file_to_string("testdata/yaml_dump_expected.txt") catch {
    _ => ""
  }
  let documents = @yaml.Yaml::load_from_string(corpus) catch {
    _ => ([] : Array[@yaml.Yaml])
  }
  let mut actual = ""
  for document in documents {
    match document {
      @yaml.Yaml::Map(cases) =>
        for name in sorted_yaml_keys(cases) {
          actual += "--CASE " + name + "\n"
          match cases.get(name) {
            Some(value) => actual += y_dump(value)
            None => ()
          }
        }
      _ => ()
    }
  }
  // Compare line by line so a failure names the offending line instead of
  // dumping a few kilobytes of YAML.
  let actual_lines = actual.split("\n").to_array()
  let expected_lines = expected.split("\n").to_array()
  let mut index = 0
  while index < actual_lines.length() && index < expected_lines.length() {
    let have = actual_lines[index].to_owned()
    let want = expected_lines[index].to_owned()
    if have != want {
      raise fail(
        "yaml dump differs at line \{index + 1}:\n  expected: \{want}\n  actual:   \{have}",
      )
    }
    index += 1
  }
  assert_eq(actual_lines.length(), expected_lines.length())
}
