///|
/// `config` prints what `yaml.safe_dump(yaml.safe_load(file))` prints, so the
/// loader has to resolve plain scalars exactly the way PyYAML's resolver does:
/// `yes` is a boolean, `08` and `1e3` are strings, `1_000` and `12:30` are
/// integers. The fixture under `testdata/` is generated by
/// `scripts/check-yaml-load.py`; rerun it after editing the corpus.
test "yaml load matches pyyaml" {
  let corpus = read_fixture("testdata/yaml_scalar_corpus.yaml")
  let expected = read_fixture("testdata/yaml_scalar_expected.txt")
  let documents = load_yaml_documents(corpus) catch {
    e => raise fail("cannot load the corpus: \{error_text(e)}")
  }
  assert_eq(documents.length(), 1)
  assert_eq(y_dump(documents[0]), expected)
}

///|
/// PyYAML turns an unquoted timestamp into a `datetime`, which then makes the
/// reference's `json.dumps` die, so there is no output to match. The loader
/// keeps it a string, and the emitter quotes it so it round-trips.
test "unquoted timestamps stay strings" {
  let documents = load_yaml_documents(
    "date: 2024-01-01\nstamp: 2024-01-01 10:00:00\n",
  ) catch {
    e => raise fail("cannot load: \{error_text(e)}")
  }
  match documents[0] {
    @yaml.Yaml::Map(m) => {
      assert_true(m.get("date") is Some(@yaml.Yaml::String(_)))
      assert_true(m.get("stamp") is Some(@yaml.Yaml::String(_)))
    }
    _ => fail("expected a mapping") |> ignore
  }
  assert_eq(
    y_dump(documents[0]),
    "date: '2024-01-01'\nstamp: '2024-01-01 10:00:00'\n",
  )
}

///|
/// PyYAML parses through Python's unbounded `int()`, so an integer literal
/// beyond `Int64` survives as a Python int and `yaml.safe_dump` prints its
/// digits unquoted. `Yaml` has no integer that wide, so the loader keeps the
/// exact decimal text in a string, and the emitter quotes a string that would
/// be read back as an integer. The digits are still right, which is what a
/// compose file needs.
test "integers beyond int64 keep their digits" {
  let cases : Array[(String, String)] = [
    ("9223372036854775808", "9223372036854775808"),
    ("-9223372036854775809", "-9223372036854775809"),
    ("123456789012345678901234567890", "123456789012345678901234567890"),
    ("1_000_000_000_000_000_000_000", "1000000000000000000000"),
    ("0xFFFFFFFFFFFFFFFF", "18446744073709551615"),
    ("0x123456789ABCDEF0123456789", "90144042682896311822508713865"),
    ("0777777777777777777777777", "4722366482869645213695"),
    ("99999999999999999999:59:59", "359999999999999999999999"),
  ]
  for entry in cases {
    let (literal, decimal) = entry
    match construct_yaml_int(literal) {
      @yaml.Yaml::String(text) => assert_eq(text, decimal)
      _ => ignore(fail("\{literal}: expected the decimal text, not an Int64"))
    }
  }
  // The two ends of the Int64 range stay integers.
  assert_eq(
    construct_yaml_int("9223372036854775807"),
    @yaml.Yaml::Integer(9223372036854775807L),
  )
  assert_eq(
    construct_yaml_int("-9223372036854775808"),
    @yaml.Yaml::Integer(-9223372036854775808L),
  )
}
